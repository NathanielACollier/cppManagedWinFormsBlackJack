<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BlackjackGame.AboutWindow"
        Title="About Blackjack"
        Width="400" Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="20" Spacing="20">
        <TextBlock Text="Version 2.0" FontSize="18" FontWeight="Bold"/>

        <TextBlock Text="Blackjack Game&#10;&#10;A card game where you try to beat the computer by getting 21 or getting closer to 21 than the computer."
                   TextWrapping="Wrap" FontSize="12"/>

        <TextBlock Text="Last Updated: Sunday, October 23, 2005" FontSize="11" Foreground="#666666"/>

        <Button Content="OK"
                Width="100"
                Height="30"
                HorizontalAlignment="Center"
                Click="OnClose"/>
    </StackPanel>

</Window>
